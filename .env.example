DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://llmfair.dev-serve.me

# API key / base URL for the Prompt Generation Agent (leave API key blank for local vLLM / llama.cpp)
PROMPT_AGENT_API_KEY=
PROMPT_AGENT_BASE_URL=http://127.0.0.1:8001/v1
PROMPT_AGENT_MODEL_NAME=gpt-4o-mini
PROMPT_AGENT_PROVIDER=openai_compatible

# API key / base URL for the Target LLM under evaluation (leave API key blank for local vLLM / llama.cpp)
TARGET_LLM_API_KEY=
TARGET_LLM_BASE_URL=https://api.openai.com/v1
TARGET_LLM_MODEL_NAME=gpt-4o-mini
# openai | evaair（長榮聊天機器人，需啟動 evaair-bot，Base URL http://127.0.0.1:8768/v1）
TARGET_LLM_PROVIDER=openai
TARGET_LLM_TIMEOUT_SECONDS=120

# Shared key for external robots posting responses back to this API.
EXTERNAL_RESPONSE_API_KEY=change-me

# Default language for LangFair model selection: en or auto.
# The frontend can override this value for an individual metrics request.
LANGFAIR_DEFAULT_LANGUAGE=en

# MatrAIx Persona service
MATRAIX_BASE_URL=http://127.0.0.1:8765
# Use the full Persona 1M pool for real prompt population.
# Download it into MatrAIx first, e.g. persona/datasets/matraix-persona-1m/release.
MATRAIX_DEFAULT_PERSONA_POOL=persona/datasets/matraix-persona-1m
MATRAIX_TIMEOUT_SECONDS=15
MATRAIX_CONNECT_TIMEOUT_SECONDS=3

# Target LLM reliability: retries after the first attempt, parallel calls per
# run (1 = sequential), and how many leading all-failed generations abort a run.
TARGET_LLM_MAX_RETRIES=2
TARGET_LLM_CONCURRENCY=1
TARGET_LLM_FAILFAST_GENERATIONS=5
# External-bot runs are marked failed after this many hours without a POST.
EXTERNAL_RUN_STALE_HOURS=24
